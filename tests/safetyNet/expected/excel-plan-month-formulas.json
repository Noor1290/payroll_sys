    {
      "key": "emoluments",
      "name": "Emoluments",
      "kind": "formula",
      "decimals": 2,
      "formula": "newBasicSalary + allowances"
    },
    {
      "key": "travelling",
      "name": "Travelling",
      "kind": "input",
      "valueType": "number",
      "decimals": 2
    },
    {
      "key": "grossPay",
      "name": "Gross Pay",
      "kind": "formula",
      "decimals": 2,
      "formula": "emoluments + travelling"
    },
    {
      "key": "aged60",
      "name": "Age 60+",
      "kind": "input",
      "valueType": "checkbox",
      "decimals": 2
    },
    {
      "key": "netPay",
      "name": "Net Pay",
      "kind": "formula",
      "decimals": 2,
      "formula": "grossPay - totalDeductions"
    },
    {
      "key": "csg",
      "name": "CSG",
      "kind": "formula",
      "decimals": 2,
      "formula": "(emoluments) * (emoluments < 50000 ? 0.015 : emoluments >= 50000 ? 0.03 : 0)"
    },
    {
      "key": "nsf",
      "name": "NSF",
      "kind": "formula",
      "decimals": 2,
      "formula": "((aged60 === 1)) ? (0) : ((Math.min(emoluments, 29710)) * (0.01))"
    },
    {
      "key": "paye",
      "name": "PAYE",
      "kind": "formula",
      "decimals": 0,
      "formula": "(Math.max(0, Math.min(emoluments, 30000) - 0)) * 0 + (Math.max(0, Math.min(emoluments, 50000) - 30000)) * 0.1 + (Math.max(0, emoluments - 50000)) * 0.2"
    },
    {
      "key": "totalDeductions",
      "name": "Total deductions",
      "kind": "formula",
      "decimals": 2,
      "formula": "csg + nsf + paye"
    },
    {
      "key": "levy",
      "name": "Levy",
      "kind": "formula",
      "decimals": 3,
      "formula": "(Math.min(emoluments, 100000)) * (emoluments === 50000 ? 0.02 : emoluments < 20000 ? 0 : emoluments > 20000 ? 0.015 : 0)"
    },
    {
      "key": "prgf",
      "name": "PRGF",
      "kind": "formula",
      "decimals": 2,
      "formula": "((emoluments > 200000) || (basicSalary < allowances)) ? (travelling) : (emoluments * 0.045)"
    },
    {
      "key": "totalMra",
      "name": "Total MRA contributions",
      "kind": "formula",
      "decimals": 2,
      "formula": "csg + nsf + paye + levy + prgf"
    },
    {
      "key": "edf",
      "name": "EDF",
      "kind": "input",
      "valueType": "number",
      "decimals": 0
    },
    {
      "key": "edfMonthly",
      "name": "EDF (monthly)",
      "kind": "formula",
      "decimals": 2,
      "formula": "edf / 13"
    },
    {
      "key": "total",
      "name": "Total",
      "kind": "formula",
      "decimals": 2,
      "formula": "(edfMonthly > emoluments) ? (0) : (emoluments - edfMonthly)"
    }
  ],
